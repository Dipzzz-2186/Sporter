extends ../layout/main

block content
  style.
    /* Modern Team Detail Page */
    .team-detail-page {
      background: #f5f7fa;
      min-height: 100vh;
    }
    
    /* Hero Section */
    .team-hero {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      padding: 3rem 0 2rem;
      position: relative;
      overflow: hidden;
      margin-bottom: 2rem;
    }
    
    .team-hero::before {
      content: '';
      position: absolute;
      top: -30%;
      right: -15%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(0, 122, 255, 0.08) 0%, transparent 70%);
      border-radius: 50%;
    }
    
    .team-hero::after {
      content: '';
      position: absolute;
      bottom: -20%;
      left: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.06) 0%, transparent 70%);
      border-radius: 50%;
    }
    
    /* Team Header */
    .team-header-content {
      position: relative;
      z-index: 2;
    }
    
    .team-icon-badge {
      width: 72px;
      height: 72px;
      background: linear-gradient(135deg, #007aff 0%, #0051d5 100%);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(0, 122, 255, 0.3);
      margin-bottom: 1.5rem;
    }
    
    .team-icon-badge i {
      font-size: 2rem;
      color: white;
    }
    
    .team-title {
      font-size: 2.5rem;
      font-weight: 800;
      color: white;
      margin-bottom: 1rem;
      letter-spacing: -0.8px;
      line-height: 1.2;
    }
    
    .team-meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    
    .team-sport-badge {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      color: white;
      padding: 0.5rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9375rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .team-member-count {
      background: rgba(16, 185, 129, 0.15);
      backdrop-filter: blur(10px);
      color: #10b981;
      padding: 0.5rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9375rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    
    /* Back Button */
    .btn-back-hero {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      text-decoration: none;
      margin-bottom: 2rem;
    }
    
    .btn-back-hero:hover {
      background: rgba(255, 255, 255, 0.2);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateX(-3px);
      color: white;
    }
    
    /* Section Container */
    .members-section {
      padding-bottom: 3rem;
    }
    
    .section-header {
      background: white;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      border: 1px solid #e8ecef;
    }
    
    .section-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 0.25rem;
      letter-spacing: -0.5px;
    }
    
    .section-subtitle {
      color: #6b7280;
      font-size: 0.9375rem;
      margin: 0;
    }
    
    /* Member Cards */
    .member-card {
      background: white;
      border-radius: 16px;
      border: 1px solid #e8ecef;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      height: 100%;
      overflow: hidden;
      position: relative;
    }
    
    .member-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #007aff 0%, #0051d5 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s ease;
    }
    
    .member-card:hover::before {
      transform: scaleX(1);
    }
    
    .member-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
      border-color: rgba(0, 122, 255, 0.2);
    }
    
    .member-card-body {
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    /* Photo */
    .member-photo-wrapper {
      position: relative;
      margin-bottom: 1.25rem;
      transition: transform 0.3s ease;
    }
    
    .member-card:hover .member-photo-wrapper {
      transform: scale(1.05);
    }
    
    .member-photo {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid #007aff;
      box-shadow: 0 4px 16px rgba(0, 122, 255, 0.2);
      position: relative;
      background: #f3f4f6;
    }
    
    .member-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
    
    .member-card:hover .member-photo img {
      transform: scale(1.1);
    }
    
    .member-photo-placeholder {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
      border: 3px solid #007aff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(0, 122, 255, 0.2);
    }
    
    .member-photo-placeholder i {
      font-size: 2.5rem;
      color: #9ca3af;
    }
    
    /* Member Info */
    .member-name {
      color: #1a1a2e;
      font-weight: 700;
      font-size: 1.125rem;
      margin-bottom: 0.75rem;
      text-decoration: none;
      transition: color 0.2s ease;
      display: block;
      letter-spacing: -0.3px;
    }
    
    .member-name:hover {
      color: #007aff;
    }
    
    .member-role-badge {
      background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
      color: #374151;
      padding: 0.375rem 1rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.8125rem;
      display: inline-flex;
      align-items: center;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border: 1px solid #d1d5db;
    }
    
    /* Profile Button */
    .btn-profile {
      background: #007aff;
      color: white;
      border: none;
      padding: 0.625rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
      text-decoration: none;
      width: 100%;
      justify-content: center;
    }
    
    .btn-profile:hover {
      background: #0051d5;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
      color: white;
    }
    
    .btn-profile i {
      transition: transform 0.2s ease;
    }
    
    .btn-profile:hover i {
      transform: translateX(3px);
    }
    
    /* Empty State */
    .empty-state {
      background: white;
      border: 2px dashed #d1d5db;
      border-radius: 16px;
      padding: 4rem 2rem;
      text-align: center;
      max-width: 500px;
      margin: 0 auto;
    }
    
    .empty-state-icon {
      width: 100px;
      height: 100px;
      background: #f3f4f6;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
    }
    
    .empty-state-icon i {
      font-size: 3rem;
      color: #9ca3af;
    }
    
    .empty-state-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 0.5rem;
      letter-spacing: -0.5px;
    }
    
    .empty-state-text {
      color: #6b7280;
      font-size: 0.9375rem;
      line-height: 1.6;
      margin: 0;
    }
    
    /* Loading State */
    .loading-skeleton {
      background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
      background-size: 200% 100%;
      animation: loading 1.5s ease-in-out infinite;
      border-radius: 8px;
    }
    
    @keyframes loading {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    
    /* Responsive */
    @media (max-width: 991px) {
      .team-hero {
        padding: 2.5rem 0 1.5rem;
      }
      
      .team-title {
        font-size: 2rem;
      }
      
      .team-icon-badge {
        width: 64px;
        height: 64px;
      }
      
      .team-icon-badge i {
        font-size: 1.75rem;
      }
    }
    
    @media (max-width: 767px) {
      .team-hero {
        padding: 2rem 0 1.5rem;
        margin-bottom: 1.5rem;
      }
      
      .team-title {
        font-size: 1.75rem;
      }
      
      .team-icon-badge {
        width: 56px;
        height: 56px;
        margin-bottom: 1rem;
      }
      
      .team-icon-badge i {
        font-size: 1.5rem;
      }
      
      .team-meta {
        gap: 0.75rem;
      }
      
      .team-sport-badge,
      .team-member-count {
        padding: 0.375rem 1rem;
        font-size: 0.875rem;
      }
      
      .member-card-body {
        padding: 1.5rem 1.25rem;
      }
      
      .member-photo,
      .member-photo-placeholder {
        width: 80px;
        height: 80px;
      }
      
      .member-photo-placeholder i {
        font-size: 2rem;
      }
      
      .section-header {
        padding: 1.25rem;
      }
      
      .section-title {
        font-size: 1.25rem;
      }
    }
    
    @media (max-width: 575px) {
      .team-title {
        font-size: 1.5rem;
      }
      
      .btn-back-hero {
        padding: 0.5rem 0.875rem;
        font-size: 0.8125rem;
      }
      
      .member-name {
        font-size: 1rem;
      }
      
      .member-role-badge {
        font-size: 0.75rem;
        padding: 0.3rem 0.875rem;
      }
      
      .empty-state {
        padding: 3rem 1.5rem;
      }
    }
    
    /* Fade In Animation */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .member-card {
      animation: fadeInUp 0.5s ease-out forwards;
      opacity: 0;
    }
    
    .member-card:nth-child(1) { animation-delay: 0.05s; }
    .member-card:nth-child(2) { animation-delay: 0.1s; }
    .member-card:nth-child(3) { animation-delay: 0.15s; }
    .member-card:nth-child(4) { animation-delay: 0.2s; }
    .member-card:nth-child(5) { animation-delay: 0.25s; }
    .member-card:nth-child(6) { animation-delay: 0.3s; }
    .member-card:nth-child(7) { animation-delay: 0.35s; }
    .member-card:nth-child(8) { animation-delay: 0.4s; }
    .member-card:nth-child(9) { animation-delay: 0.45s; }
    .member-card:nth-child(10) { animation-delay: 0.5s; }
    .member-card:nth-child(11) { animation-delay: 0.55s; }
    .member-card:nth-child(12) { animation-delay: 0.6s; }

  .team-detail-page
    //- Hero Section
    .team-hero
      .container
        .team-header-content
          - const isSubadmin = currentUser && (currentUser.role === 'subadmin' || currentUser.role === 'admin')
          - const mode = team.is_individual ? 'individual' : 'team'
          - const backUrl = isSubadmin ? `/subadmin/standings?sport_id=${team.sport_id}&mode=${mode}` : `/standings?sport_id=${team.sport_id}&mode=${mode}`
          
          a.btn-back-hero(href=backUrl)
            i.bi.bi-arrow-left
            span Kembali
          
          .team-icon-badge
            i.bi.bi-people-fill
          
          h1.team-title= team.name
          
          .team-meta
            span.team-sport-badge
              i.bi.bi-trophy
              = team.sport_name
            
            if members && members.length > 0
              span.team-member-count
                i.bi.bi-people-fill
                = members.length + ' Anggota'

    //- Members Section
    .members-section
      .container
        //- Section Header
        .section-header
          h2.section-title Anggota Tim
          p.section-subtitle
            if members && members.length
              | #{members.length} atlet terdaftar dalam tim ini
            else
              | Belum ada anggota yang terdaftar
        
        //- Members Grid
        if members && members.length
          .row.g-3.g-md-4
            each m in members
              .col-6.col-md-4.col-lg-3
                .member-card
                  .member-card-body
                    //- Photo
                    .member-photo-wrapper
                      if m.photo_url
                        .member-photo
                          img(
                            src=m.photo_url
                            alt=m.name
                            loading="lazy"
                          )
                      else
                        .member-photo-placeholder
                          i.bi.bi-person-circle
                    
                    //- Member Info
                    a.member-name(href=`/athletes/${m.slug}`)= m.name
                    
                    if m.role
                      span.member-role-badge= m.role
                    
                    //- Profile Button
                    a.btn-profile(href=`/athletes/${m.slug}`)
                      | Lihat Profil
                      i.bi.bi-arrow-right
        else
          //- Empty State
          .empty-state
            .empty-state-icon
              i.bi.bi-people
            h3.empty-state-title Belum Ada Anggota
            p.empty-state-text Tim ini belum memiliki anggota. Anggota baru akan muncul di sini setelah ditambahkan.

  //- Enhanced JavaScript
  script.
    (function() {
      // Lazy load images with fade effect
      if ('IntersectionObserver' in window) {
        const imageObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const img = entry.target;
              img.style.opacity = '0';
              img.style.transition = 'opacity 0.3s ease';
              
              if (img.dataset.src) {
                img.src = img.dataset.src;
                img.removeAttribute('data-src');
              }
              
              img.onload = () => {
                img.style.opacity = '1';
              };
              
              observer.unobserve(img);
            }
          });
        }, {
          rootMargin: '50px 0px',
          threshold: 0.1
        });
        
        document.querySelectorAll('img[loading="lazy"]').forEach(img => {
          imageObserver.observe(img);
        });
      }
      
      // Card animation observer
      if ('IntersectionObserver' in window) {
        const cardObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.style.animationPlayState = 'running';
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -30px 0px'
        });
        
        document.querySelectorAll('.member-card').forEach(card => {
          card.style.animationPlayState = 'paused';
          cardObserver.observe(card);
        });
      }
      
      // Add loading state to buttons
      document.querySelectorAll('.btn-profile').forEach(btn => {
        btn.addEventListener('click', function(e) {
          if (this.href && !this.href.includes('javascript:')) {
            this.style.opacity = '0.6';
            this.style.pointerEvents = 'none';
            
            const icon = this.querySelector('i');
            if (icon) {
              icon.className = 'bi bi-hourglass-split';
            }
          }
        });
      });
      
      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
      
      // Add keyboard navigation
      document.querySelectorAll('.member-card').forEach(card => {
        card.setAttribute('tabindex', '0');
        
        card.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') {
            const link = this.querySelector('.btn-profile');
            if (link) link.click();
          }
        });
      });
      
      // Performance: defer non-critical animations
      setTimeout(() => {
        document.querySelectorAll('.member-card').forEach(card => {
          card.style.willChange = 'transform, box-shadow';
        });
      }, 1000);
    })();