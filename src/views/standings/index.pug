extends ../layout/main

block content
  style.
    /* Standings Page Styles - Professional Edition */
    .standings-page {
      background: #f5f7fa;
      min-height: 100vh;
      padding: 2rem 0;
    }
    
    .standings-header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 1.5rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }
    
    .standings-header::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 350px;
      height: 350px;
      background: radial-gradient(circle, rgba(0, 122, 255, 0.1) 0%, transparent 70%);
      border-radius: 50%;
    }
    
    /* ===== HEADER CONTENT ===== */
    .header-content-wrapper {
      position: relative;
      z-index: 2;
    }
    
    .header-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }
    
    .standings-header h3 {
      color: white;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    
    .standings-header h3 i {
      color: #ffd700;
      font-size: 1.5rem;
      filter: drop-shadow(0 2px 4px rgba(255, 215, 0, 0.3));
    }
    
    /* ===== Back Button ===== */
    .btn-back-modern {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255,255,255,.1);
      color: #fff;
      border: 1px solid rgba(255,255,255,.2);
      border-radius: 8px;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s ease;
      text-decoration: none;
      backdrop-filter: blur(10px);
    }

    .btn-back-modern:hover {
      background: rgba(255,255,255,.2);
      transform: translateX(-3px);
      color: #fff;
      border-color: rgba(255,255,255,.3);
    }

    /* ===== Mode Switch ===== */
    .mode-switch-wrapper {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .mode-switch {
      display: inline-flex;
      background: rgba(255,255,255,.08);
      border-radius: 10px;
      padding: 0.25rem;
      gap: 0.25rem;
      border: 1px solid rgba(255,255,255,.1);
    }

    .mode-switch a {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 600;
      color: rgba(255,255,255,.7);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .mode-switch a.inactive:hover {
      background: rgba(255,255,255,.12);
      color: #fff;
    }

    .mode-switch a.active {
      background: #fff;
      color: #1a1a2e;
      box-shadow: 0 2px 8px rgba(0,0,0,.15);
    }
    
    /* ===== Filter Section ===== */
    .filter-section {
      background: white;
      border-radius: 12px;
      padding: 1.25rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      margin-bottom: 1.5rem;
      border: 1px solid #e8ecef;
    }
    
    .filter-section label {
      color: #1a1a2e;
      font-weight: 600;
      font-size: 0.875rem;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .filter-section label i {
      color: #007aff;
    }
    
    .filter-section select {
      border-radius: 8px;
      border: 1px solid #d1d5db;
      padding: 0.65rem 1rem;
      font-size: 0.9375rem;
      transition: all 0.2s ease;
      background-color: #fafbfc;
    }
    
    .filter-section select:focus {
      border-color: #007aff;
      background-color: #fff;
      box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.1);
      outline: none;
    }
    
    /* ===== Standings Group ===== */
    .standings-group {
      background: white;
      border-radius: 12px;
      padding: 0;
      margin-bottom: 1.5rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      border: 1px solid #e8ecef;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    
    .standings-group:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }
    
    /* ===== Group Title ===== */
    .group-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1.25rem 1.5rem;
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      border-bottom: 1px solid #e8ecef;
    }
    
    .group-title-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #007aff 0%, #0051d5 100%);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 122, 255, 0.2);
    }
    
    .group-title-icon i {
      font-size: 1.25rem;
      color: white;
    }
    
    .group-title h5 {
      color: #1a1a2e;
      font-weight: 700;
      font-size: 1.125rem;
      margin: 0;
      letter-spacing: -0.3px;
    }
    
    /* ===== Standings Table ===== */
    .standings-table {
      overflow: hidden;
    }
    
    .standings-table table {
      margin-bottom: 0;
      width: 100%;
    }
    
    .standings-table thead {
      background: #fafbfc;
      border-bottom: 2px solid #e8ecef;
    }
    
    .standings-table thead th {
      color: #6b7280 !important;
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 0.875rem 1rem;
      border: none;
      white-space: nowrap;
      background: transparent !important;
    }
    
    .standings-table tbody tr {
      transition: all 0.15s ease;
      border-bottom: 1px solid #f3f4f6;
    }
    
    .standings-table tbody tr:last-child {
      border-bottom: none;
    }
    
    .standings-table tbody tr:hover {
      background: #f8f9fa;
    }
    
    .standings-table tbody td {
      padding: 1rem;
      vertical-align: middle;
      font-size: 0.9375rem;
      color: #374151;
    }
    
    /* ===== Position Column ===== */
    .position-cell {
      font-weight: 700;
      width: 60px;
      text-align: center;
    }
    
    .position-badge {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.875rem;
    }
    
    .position-1 {
      background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
      color: #8b6914;
      box-shadow: 0 2px 6px rgba(255, 215, 0, 0.3);
    }
    
    .position-2 {
      background: linear-gradient(135deg, #c0c0c0 0%, #d3d3d3 100%);
      color: #5a5a5a;
      box-shadow: 0 2px 6px rgba(192, 192, 192, 0.3);
    }
    
    .position-3 {
      background: linear-gradient(135deg, #cd7f32 0%, #d4915d 100%);
      color: #6b4423;
      box-shadow: 0 2px 6px rgba(205, 127, 50, 0.3);
    }
    
    .position-other {
      background: #f3f4f6;
      color: #6b7280;
      font-weight: 600;
    }
    
    /* ===== Team Name ===== */
    .team-name {
      font-weight: 600;
      color: #1a1a2e;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .team-name i {
      color: #007aff;
      font-size: 1rem;
    }
    
    /* ===== Stat Cells ===== */
    .stat-cell {
      font-weight: 500;
      color: #6b7280;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }
    
    .points-cell {
      font-weight: 700;
      font-size: 1.125rem;
      color: #1a1a2e;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }
    
    /* ===== Win/Loss Indicators ===== */
    .win-indicator {
      color: #10b981;
      font-weight: 600;
    }
    
    .loss-indicator {
      color: #ef4444;
      font-weight: 600;
    }
    
    /* ===== Diff Colors ===== */
    .diff-positive {
      color: #10b981;
      font-weight: 600;
    }
    
    .diff-positive::before {
      content: '+';
    }

    .diff-negative {
      color: #ef4444;
      font-weight: 600;
    }

    .diff-zero {
      color: #9ca3af;
      font-weight: 500;
    }
    
    /* ===== Action Buttons ===== */
    .action-buttons {
      display: flex;
      gap: 0.375rem;
      justify-content: center;
    }
    
    .btn-action-compact {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      padding: 0.375rem 0.75rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.75rem;
      text-decoration: none;
      transition: all 0.2s ease;
      border: none;
      white-space: nowrap;
    }
    
    .btn-win-compact {
      background: #10b981;
      color: white;
    }
    
    .btn-win-compact:hover {
      background: #059669;
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
      color: white;
    }
    
    .btn-loss-compact {
      background: #007aff;
      color: white;
    }
    
    .btn-loss-compact:hover {
      background: #0051d5;
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(0, 122, 255, 0.3);
      color: white;
    }
    
    /* ===== Empty State ===== */
    .empty-state {
      background: white;
      border: 2px dashed #d1d5db;
      border-radius: 12px;
      padding: 4rem 2rem;
      text-align: center;
    }
    
    .empty-state-icon {
      width: 80px;
      height: 80px;
      background: #f3f4f6;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
    }
    
    .empty-state-icon i {
      font-size: 2.5rem;
      color: #9ca3af;
    }
    
    .empty-state h4 {
      font-family: 'Inter', sans-serif;
      font-size: 1.5rem;
      color: #1a1a2e;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin-bottom: 0.5rem;
    }
    
    .empty-state p {
      color: #6b7280;
      font-size: 1rem;
      margin: 0;
    }
    
    /* ===== Form Letters (Recent Form) ===== */
    .form-letters {
      display: flex;
      gap: 0.25rem;
      justify-content: center;
    }
    
    .form-letter {
      width: 24px;
      height: 24px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
    }
    
    .form-w {
      background: #10b981;
      color: white;
    }
    
    .form-l {
      background: #ef4444;
      color: white;
    }
    
    .form-d {
      background: #f59e0b;
      color: white;
    }
    
    /* ===== Responsive ===== */
    @media (max-width: 991px) {
      .standings-header {
        padding: 1.5rem;
      }
      
      .standings-header h3 {
        font-size: 1.5rem;
      }
      
      .header-title-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
      
      .btn-back-modern {
        order: -1;
      }
    }
    
    @media (max-width: 767px) {
      .standings-page {
        padding: 1rem 0;
      }
      
      .standings-header {
        padding: 1.25rem;
        border-radius: 12px;
      }
      
      .standings-header h3 {
        font-size: 1.25rem;
      }
      
      .group-title {
        padding: 1rem;
      }
      
      .group-title h5 {
        font-size: 1rem;
      }
      
      .standings-table {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      
      .standings-table table {
        min-width: 700px;
      }
      
      .standings-table thead th,
      .standings-table tbody td {
        padding: 0.75rem 0.5rem;
        font-size: 0.875rem;
      }
      
      .btn-action-compact {
        padding: 0.3rem 0.6rem;
        font-size: 0.7rem;
      }
      
      .position-badge {
        width: 28px;
        height: 28px;
        font-size: 0.8rem;
      }
    }
    
    /* ===== Smooth Scroll ===== */
    html {
      scroll-behavior: smooth;
    }
    
    /* ===== Loading State ===== */
    .loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(255, 255, 255, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    
    .loading-overlay.active {
      opacity: 1;
      pointer-events: all;
    }
    
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid #e8ecef;
      border-top-color: #007aff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

  .standings-page
    .container
      .standings-header
        //- Back Button
        - const sport = sports && query && query.sport_id ? sports.find(s => Number(s.id) === Number(query.sport_id)) : null;
        - const backUrl = sport ? ('/sports/' + encodeURIComponent(sport.name)) : '/sports/';
        
        .header-content-wrapper
          .header-title-row
            h3
              i.bi.bi-trophy-fill
              | Klasemen
            
            a.btn-back-modern(href=backUrl)
              i.bi.bi-arrow-left
              | Kembali

          //- Mode Switch
          .mode-switch-wrapper
            - const mode = (query && query.mode) ? String(query.mode) : 'team';
            - const sportParam = (query && query.sport_id) ? `sport_id=${query.sport_id}` : '';
            
            .mode-switch
              a(
                class=(mode === 'team' ? 'active' : 'inactive')
                href=`/standings?${sportParam}&mode=team`
              )
                i.bi.bi-people-fill
                | Tim
              
              a(
                class=(mode === 'individual' ? 'active' : 'inactive')
                href=`/standings?${sportParam}&mode=individual`
              )
                i.bi.bi-person-fill
                | Individual

      // === Filter Section ===
      if sports && sports.length > 1
        .filter-section
          label
            i.bi.bi-funnel-fill
            | Pilih Cabang Olahraga
          - const mode = (query && query.mode) ? String(query.mode) : 'team';

          select.form-select(
            name="sport_id"
            onchange=`location.href='?sport_id=' + this.value + '&mode=${mode}'`
          )
            option(value="") Semua Cabang
            each s in sports
              option(
                value=s.id
                selected=(query && Number(query.sport_id) === s.id)
              )= s.name

      include ./_table.pug

  //- Loading Overlay
  .loading-overlay
    .spinner

  //- Enhanced JavaScript
  script.
    (function() {
      // Smooth filter changes
      var sportFilter = document.querySelector('select[name="sport_id"]');
      var loadingOverlay = document.querySelector('.loading-overlay');
      
      if (sportFilter) {
        sportFilter.addEventListener('change', function(e) {
          if (loadingOverlay) {
            loadingOverlay.classList.add('active');
          }
        });
      }
      
      // Enhanced hover effects
      var rows = document.querySelectorAll('.standings-table tbody tr');
      rows.forEach(function(row, index) {
        row.style.setProperty('--row-index', index);
      });
      
      // Smooth scroll to top
      window.addEventListener('load', function() {
        if (window.location.hash) {
          var element = document.querySelector(window.location.hash);
          if (element) {
            element.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    })();