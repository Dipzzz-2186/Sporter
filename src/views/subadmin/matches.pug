        script.
          (function () {
            function bindDeleteConfirm() {
              var deleteForms = document.querySelectorAll('form[action*="/delete"]');
              deleteForms.forEach(function (form) {
                if (form.dataset.bound === '1') return;
                form.dataset.bound = '1';
                form.addEventListener('submit', function (e) {
                  e.preventDefault();
                  var btn = form.querySelector('button[type="submit"]');
                  var confirmed = confirm(
                    '⚠️ Yakin ingin menghapus pertandingan ini?\n\nData yang sudah dihapus tidak dapat dikembalikan.'
                  );
                  if (confirmed) {
                    btn.innerHTML =
                      '<span class="spinner-border spinner-border-sm"></span>';
                    btn.disabled = true;
                    form.submit();
                  }
                });
              });
            }

            function animateRows() {
              if (!('IntersectionObserver' in window)) return;

              var observer = new IntersectionObserver(
                function (entries) {
                  entries.forEach(function (entry, index) {
                    if (entry.isIntersecting) {
                      setTimeout(function () {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateX(0)';
                      }, index * 50);
                    }
                  });
                },
                {
                  threshold: 0.1,
                  rootMargin: '0px 0px -50px 0px',
                }
              );

              document
                .querySelectorAll('.matches-table tbody tr')
                .forEach(function (row) {
                  row.style.opacity = '0';
                  row.style.transform = 'translateX(-20px)';
                  row.style.transition = 'all 0.4s ease';
                  observer.observe(row);
                });
            }

            // Auto dismiss alerts after 5 seconds
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function (alert) {
              setTimeout(function () {
                alert.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                alert.style.opacity = '0';
                alert.style.transform = 'translateY(-20px)';
                setTimeout(function () {
                  alert.remove();
                }, 500);
              }, 5000);
            });

            window.bindMatchesTableHandlers = function () {
              bindDeleteConfirm();
              animateRows();
            };

            window.bindMatchesTableHandlers();
          })();

        script.
          // helper toast function
          function showToast(msg, type = 'success') {
            const container = document.getElementById('toastTopCenter') || document.body;

            const el = document.createElement('div');
            el.className = `alert alert-${type}`;
            el.style.minWidth = '320px';
            el.style.maxWidth = '560px';
            el.style.boxShadow = '0 10px 30px rgba(0,0,0,.15)';
            el.innerText = msg;

            container.appendChild(el);
            setTimeout(() => el.remove(), 2200);
          }

          function clampScore(value) {
            if (Number.isNaN(value)) return 0;
            return Math.min(7, Math.max(0, value));
          }

          function isValidSetScore(home, away) {
            if (!Number.isInteger(home) || !Number.isInteger(away)) return false;
            if (home < 0 || away < 0) return false;
            if (home === away) return false;
            if (home > 7 || away > 7) return false;

            const max = Math.max(home, away);
            const min = Math.min(home, away);
            const diff = max - min;

            if (max === 6) {
              return diff >= 2;
            }

            if (max === 7) {
              return (min >= 5) && (diff === 1 || diff === 2);
            }

            return false;
          }

          function updateSetButtonState() {
            const btnSet = document.querySelector(
              '#padelScoreModal .btn-primary'
            );
            if (!btnSet) return;
            const home = Number(document.getElementById('homeScore').value);
            const away = Number(document.getElementById('awayScore').value);
            btnSet.disabled = !isValidSetScore(home, away);
          }

          function setScoreInput(id, value) {
            const el = document.getElementById(id);
            if (!el) return;
            el.value = clampScore(value);
          }

          function openScoreModal(btn) {
            const mode = btn.dataset.mode;
            document.getElementById('matchId').value = btn.dataset.matchId;
            const setNo = Number(btn.dataset.setNo || 1);
            const setLabel = document.getElementById('currentSetLabel');
            if (setLabel) {
              const safeSetNo = Math.min(3, Math.max(1, setNo));
              setLabel.innerText = `Set ${safeSetNo}`;
            }

            if (mode === 'individual') {
              const names = (btn.dataset.participants || '').split(' vs ');
              document.getElementById('homeLabel').innerText =
                names[0] || 'Peserta 1';
              document.getElementById('awayLabel').innerText =
                names[1] || 'Peserta 2';
              document.getElementById('padelScoreModal').dataset.mode =
                'individual';
            } else {
              document.getElementById('homeLabel').innerText =
                btn.dataset.home || 'Home';
              document.getElementById('awayLabel').innerText =
                btn.dataset.away || 'Away';
              document.getElementById('padelScoreModal').dataset.mode = 'team';
            }

            const liveHome = Number(btn.dataset.liveHome || 0);
            const liveAway = Number(btn.dataset.liveAway || 0);
            setScoreInput('homeScore', liveHome);
            setScoreInput('awayScore', liveAway);
            updateSetButtonState();
            new bootstrap.Modal(
              document.getElementById('padelScoreModal')
            ).show();
          }

          document.querySelectorAll('.btn-score').forEach((btn) => {
            btn.addEventListener('click', () => {
              const target = btn.dataset.target;
              const delta = Number(btn.dataset.delta || 0);
              const input = document.getElementById(target);
              if (!input) return;
              const current = Number(input.value || 0);
              const otherId = target === 'homeScore' ? 'awayScore' : 'homeScore';
              const otherVal = Number((document.getElementById(otherId) || {}).value || 0);
              const nextVal = current + delta;

              // aturan: ke angka 7 hanya boleh kalau lawan 5 atau 6
              if (nextVal === 7 && otherVal < 5) {
                alert('Skor 7 hanya boleh jika lawan sudah 5 atau 6 (7–5 / 7–6).');
                return;
              }

              setScoreInput(target, nextVal);
              updateSetButtonState();
            });
          });

          ['homeScore', 'awayScore'].forEach((id) => {
            const input = document.getElementById(id);
            if (input) {
              input.addEventListener('input', updateSetButtonState);
              input.addEventListener('change', updateSetButtonState);
            }
          });

          async function submitPadelLiveScore() {
            const modal = document.getElementById('padelScoreModal');
            const mode = modal.dataset.mode;
            const matchId = document.getElementById('matchId').value;
            const home = Number(document.getElementById('homeScore').value);
            const away = Number(document.getElementById('awayScore').value);

            if (!Number.isInteger(home) || !Number.isInteger(away)) {
              alert('Isi skor live yang valid');
              return;
            }

            if (home < 0 || away < 0) {
              alert('Skor live tidak boleh negatif');
              return;
            }

            const max = Math.max(home, away);
            if (max > 7) {
              alert('Skor live maksimal 7');
              return;
            }

            if (max === 7) {
              const min = Math.min(home, away);
              const diff = max - min;
              if (min < 5 || !(diff === 1 || diff === 2)) {
                alert('Skor 7 hanya boleh 7–5 atau 7–6');
                return;
              }
            }

            if (max === 6 && home !== 6 && away !== 6) {
              alert('Skor live maksimal 6 (kecuali tie-break)');
              return;
            }

            const url =
              mode === 'individual'
                ? `/subadmin/matches/${matchId}/submit-individual-live-score`
                : `/subadmin/matches/${matchId}/submit-live-score`;

            const btnSave = document.querySelector(
              '#padelScoreModal .btn-outline-primary'
            );
            if (btnSave) {
              btnSave.disabled = true;
              btnSave.dataset.orig = btnSave.innerHTML;
              btnSave.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2"></span>Simpan Live';
            }

            try {
              const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  home_score: home,
                  away_score: away,
                }),
              });

              let data;
              try {
                data = await res.json();
              } catch (e) {
                data = null;
              }

              if (btnSave) {
                btnSave.disabled = false;
                btnSave.innerHTML = btnSave.dataset.orig || 'Simpan Live';
              }

              if (!res.ok || !data || data.success === false) {
                alert((data && data.message) || 'Gagal menyimpan live score');
                return;
              }

              const actionBtn = document.querySelector(
                `button[data-match-id="${matchId}"]`
              );
              if (actionBtn) {
                actionBtn.dataset.liveHome = String(home);
                actionBtn.dataset.liveAway = String(away);
              }

              showToast('Live score tersimpan', 'success');
            } catch (err) {
              console.error(err);
              if (btnSave) {
                btnSave.disabled = false;
                btnSave.innerHTML = btnSave.dataset.orig || 'Simpan Live';
              }
              alert('Terjadi kesalahan, coba lagi.');
            }
          }

          async function submitPadelScore() {
            const modal = document.getElementById('padelScoreModal');
            const mode = modal.dataset.mode;
            const matchId = document.getElementById('matchId').value;
            const home = Number(document.getElementById('homeScore').value);
            const away = Number(document.getElementById('awayScore').value);

            if (Number.isNaN(home) || Number.isNaN(away)) {
              alert('Isi skor yang valid');
              return;
            }

            if (home === away) {
              alert('Skor tidak boleh seri');
              return;
            }

            if (home > 7 || away > 7) {
              alert('Skor maksimal adalah 7');
              return;
            }

            const max = Math.max(home, away);
            const min = Math.min(home, away);
            const diff = max - min;

            if (max === 6 && diff < 2) {
              alert('Skor 6 harus selisih minimal 2 (contoh: 6–4)');
              return;
            }

            if (max === 7 && !(diff === 1 || diff === 2)) {
              alert('Skor 7 hanya boleh 7–5 atau 7–6');
              return;
            }

            if (max < 6) {
              alert('Set belum selesai');
              return;
            }

            const url =
              mode === 'individual'
                ? `/subadmin/matches/${matchId}/submit-individual-score`
                : `/subadmin/matches/${matchId}/submit-score`;

            const btnSave = document.querySelector(
              '#padelScoreModal .btn-primary'
            );
            if (btnSave) {
              btnSave.disabled = true;
              btnSave.dataset.orig = btnSave.innerHTML;
              btnSave.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2"></span>Simpan';
            }

            try {
              const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  home_score: home,
                  away_score: away,
                }),
              });

              let data;
              try {
                data = await res.json();
              } catch (e) {
                data = null;
              }

              if (btnSave) {
                btnSave.disabled = false;
                btnSave.innerHTML = btnSave.dataset.orig || 'Simpan';
              }

              if (!res.ok || !data || data.success === false) {
                alert((data && data.message) || 'Gagal menyimpan skor');
                return;
              }

              const finished = !!data.finished;
              const bsModal = bootstrap.Modal.getInstance(modal);
              if (bsModal) bsModal.hide();

              const actionBtn = document.querySelector(
                `button[data-match-id="${matchId}"]`
              );

              if (finished) {
                if (actionBtn) {
                  const parent = actionBtn.parentElement;
                  const finishedSpan = document.createElement('span');
                  finishedSpan.className = 'status-badge status-finished';
                  finishedSpan.innerHTML =
                    '<i class="bi bi-check-circle me-1"></i> BO3 Selesai';
                  parent.replaceChild(finishedSpan, actionBtn);
                }
                showToast('Match selesai (BO3)', 'success');
              } else {
                if (actionBtn) {
                  const nextSet = Math.min(3, (Number(actionBtn.dataset.setNo || 1) + 1));
                  actionBtn.dataset.setNo = String(nextSet);
                  actionBtn.dataset.liveHome = '0';
                  actionBtn.dataset.liveAway = '0';
                }
                showToast(
                  'Skor tersimpan — lanjut set berikutnya',
                  'success'
                );
              }
            } catch (err) {
              console.error(err);
              if (btnSave) {
                btnSave.disabled = false;
                btnSave.innerHTML = btnSave.dataset.orig || 'Simpan';
              }
              alert('Terjadi kesalahan, coba lagi.');
            }
          }






