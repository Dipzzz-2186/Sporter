  .sport-detail-page
    //- Hero Section
    .sport-hero
      .container
        .sport-hero-content
          //- Sport Icon (Dynamic based on sport name)
          - var iconClass = sport.icon || 'bi-trophy-fill'
          - if (sport.name.toLowerCase().includes('golf')) iconClass = 'bi-circle-fill'
          - if (sport.name.toLowerCase().includes('basket')) iconClass = 'bi-dribbble'
          - if (sport.name.toLowerCase().includes('sepak') || sport.name.toLowerCase().includes('football') || sport.name.toLowerCase().includes('soccer')) iconClass = 'bi-trophy-fill'
          - if (sport.name.toLowerCase().includes('tenis') || sport.name.toLowerCase().includes('tennis')) iconClass = 'bi-circle'
          - if (sport.name.toLowerCase().includes('badminton') || sport.name.toLowerCase().includes('bulutangkis')) iconClass = 'bi-slash-circle'
          - if (sport.name.toLowerCase().includes('voli') || sport.name.toLowerCase().includes('volley')) iconClass = 'bi-globe2'
          - if (sport.name.toLowerCase().includes('run') || sport.name.toLowerCase().includes('lari') || sport.name.toLowerCase().includes('marathon')) iconClass = 'bi-person-walking'
          - if (sport.name.toLowerCase().includes('padel')) iconClass = 'bi-square'
          - if (sport.name.toLowerCase().includes('swim') || sport.name.toLowerCase().includes('renang')) iconClass = 'bi-water'
          - if (sport.name.toLowerCase().includes('box') || sport.name.toLowerCase().includes('tinju')) iconClass = 'bi-shield-fill'
          - if (sport.name.toLowerCase().includes('cycling') || sport.name.toLowerCase().includes('sepeda')) iconClass = 'bi-bicycle'
          - if (sport.name.toLowerCase().includes('fitness') || sport.name.toLowerCase().includes('gym')) iconClass = 'bi-heart-pulse-fill'
          - if (sport.name.toLowerCase().includes('yoga')) iconClass = 'bi-person-arms-up'
          - if (sport.name.toLowerCase().includes('esport') || sport.name.toLowerCase().includes('gaming')) iconClass = 'bi-controller'
          
          .sport-icon-large
            i(class=iconClass)
          
          .sport-badge
            i.bi.bi-star-fill
            | Platform Olahraga #1 Indonesia
          
          h1= sport.name
          
          if sport.description
            p.sport-description= sport.description
          else
            p.sport-description Asthapora mengumpulkan informasi olahraga Indonesia: event, jadwal pertandingan, skor, klasemen, livestream, dan tiket dalam satu platform yang mudah digunakan.
          
          .hero-actions
            a.btn-hero.btn-hero-primary(href="#jadwal")
              i.bi.bi-calendar-check-fill
              span Lihat Jadwal

            a.btn-hero.btn-hero-outline(href="/standings?sport_id=" + sport.id)
              i.bi.bi-bar-chart-steps
              span Lihat Klasemen

            a.btn-hero.btn-hero-outline(href="/sports")
              i.bi.bi-arrow-left-circle-fill
              span Kembali

    //- Stats Section
    .stats-section
      .container
        .row.g-3.g-md-4
          .col-6.col-md-4
            .stat-card
              .stat-icon
                i.bi.bi-trophy-fill
              .stat-number= matches.length
              .stat-label Pertandingan
          
          .col-6.col-md-4
            .stat-card
              .stat-icon
                i.bi.bi-calendar-event-fill
              .stat-number 12
              .stat-label Event Aktif
          
          .col-12.col-md-4
            .stat-card
              .stat-icon
                i.bi.bi-people-fill
