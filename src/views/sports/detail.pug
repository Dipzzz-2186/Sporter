extends ../layout/main

block content
  style.
    /* Sport Detail Page - Professional & Modern Design */
    .sport-detail-page {
      background: linear-gradient(180deg, #0B1F3F 0%, #152844 50%, #1a3454 100%);
      min-height: 100vh;
      padding: 0;
      position: relative;
    }
    
    .sport-detail-page::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 600px;
      background: radial-gradient(ellipse at top, rgba(0, 149, 255, 0.15) 0%, transparent 70%);
      pointer-events: none;
    }
    
    /* Hero Section - Enhanced */
    .sport-hero {
      background: linear-gradient(135deg, #0095FF 0%, #00D4FF 100%);
      padding: 2.5rem 0 2rem;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(0, 149, 255, 0.3);
    }
    
    @media (min-width: 768px) {
      .sport-hero {
        padding: 4rem 0 3rem;
      }
    }
    
    @media (min-width: 992px) {
      .sport-hero {
        padding: 5rem 0 4rem;
      }
    }
    
    .sport-hero::before,
    .sport-hero::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
      animation: float 8s ease-in-out infinite;
    }
    
    .sport-hero::before {
      top: -20%;
      right: -10%;
      width: 500px;
      height: 500px;
    }
    
    .sport-hero::after {
      bottom: -15%;
      left: -8%;
      width: 350px;
      height: 350px;
      animation-delay: -4s;
      animation-direction: reverse;
    }
    
    @keyframes float {
      0%, 100% {
        transform: translate(0, 0) rotate(0deg) scale(1);
      }
      25% {
        transform: translate(20px, -20px) rotate(5deg) scale(1.05);
      }
      50% {
        transform: translate(0, -30px) rotate(0deg) scale(1);
      }
      75% {
        transform: translate(-20px, -10px) rotate(-5deg) scale(1.05);
      }
    }
    
    .sport-hero-content {
      position: relative;
      z-index: 2;
    }
    
    /* Sport Icon - NEW */
    .sport-icon-large {
      width: 80px;
      height: 80px;
      background: rgba(255, 255, 255, 0.25);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      border: 3px solid rgba(255, 255, 255, 0.4);
      animation: bounceIn 0.8s ease-out;
    }
    
    @media (min-width: 768px) {
      .sport-icon-large {
        width: 100px;
        height: 100px;
        border-radius: 24px;
      }
    }
    
    .sport-icon-large i {
      font-size: 2.5rem;
      color: white;
      filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
    }
    
    @media (min-width: 768px) {
      .sport-icon-large i {
        font-size: 3.5rem;
      }
    }
    
    @keyframes bounceIn {
      0% {
        opacity: 0;
        transform: scale(0.3) rotate(-15deg);
      }
      50% {
        opacity: 1;
        transform: scale(1.05) rotate(5deg);
      }
      70% {
        transform: scale(0.9) rotate(-3deg);
      }
      100% {
        transform: scale(1) rotate(0deg);
      }
    }
    
    .sport-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.25);
      backdrop-filter: blur(15px);
      padding: 0.6rem 1.25rem;
      border-radius: 50px;
      color: white;
      font-weight: 600;
      margin-bottom: 1.5rem;
      font-size: 0.85rem;
      animation: fadeInDown 0.6s ease-out;
      border: 2px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    }
    
    @media (min-width: 768px) {
      .sport-badge {
        padding: 0.7rem 1.5rem;
        font-size: 0.95rem;
        margin-bottom: 2rem;
      }
    }
    
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .sport-hero h1 {
      font-family: 'Bebas Neue', cursive;
      font-size: 2.5rem;
      color: white;
      letter-spacing: 2px;
      margin-bottom: 1rem;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      animation: fadeInUp 0.6s ease-out 0.2s both;
      line-height: 1.1;
      font-weight: 700;
    }
    
    @media (min-width: 576px) {
      .sport-hero h1 {
        font-size: 3rem;
      }
    }
    
    @media (min-width: 768px) {
      .sport-hero h1 {
        font-size: 4rem;
        margin-bottom: 1.5rem;
        letter-spacing: 3px;
      }
    }
    
    @media (min-width: 992px) {
      .sport-hero h1 {
        font-size: 4.5rem;
      }
    }
    
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .sport-description {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.95);
      line-height: 1.7;
      animation: fadeInUp 0.6s ease-out 0.4s both;
      margin-bottom: 2rem;
      font-weight: 400;
    }
    
    @media (min-width: 768px) {
      .sport-description {
        font-size: 1.15rem;
        line-height: 1.8;
        max-width: 750px;
        margin-bottom: 2.5rem;
      }
    }
    
    @media (min-width: 992px) {
      .sport-description {
        font-size: 1.25rem;
        line-height: 1.9;
      }
    }
    
    .hero-actions {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      animation: fadeInUp 0.6s ease-out 0.6s both;
    }
    
    @media (min-width: 576px) {
      .hero-actions {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 1.25rem;
      }
    }
    
    .btn-hero {
      padding: 1rem 2rem;
      border-radius: 14px;
      font-weight: 700;
      font-size: 0.95rem;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      text-decoration: none;
      width: 100%;
      text-align: center;
      touch-action: manipulation;
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    
    @media (min-width: 576px) {
      .btn-hero {
        width: auto;
        padding: 1.1rem 2.25rem;
        font-size: 1rem;
      }
    }
    
    @media (min-width: 768px) {
      .btn-hero {
        padding: 1.2rem 2.5rem;
        border-radius: 16px;
      }
    }
    
    .btn-hero::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }
    
    .btn-hero:active::before {
      width: 300px;
      height: 300px;
    }
    
    .btn-hero-primary {
      background: white;
      color: #0095FF;
      border: 3px solid white;
    }
    
    .btn-hero-primary:active {
      transform: scale(0.97);
    }
    
    @media (min-width: 768px) {
      .btn-hero-primary:hover {
        background: rgba(255, 255, 255, 0.95);
        transform: translateY(-4px);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
        color: #0066CC;
      }
    }
    
    .btn-hero-outline {
      background: transparent;
      color: white;
      border: 3px solid white;
      backdrop-filter: blur(10px);
    }
    
    .btn-hero-outline:active {
      transform: scale(0.97);
    }
    
    @media (min-width: 768px) {
      .btn-hero-outline:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: translateY(-4px);
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
        color: white;
      }
    }
    
    /* Stats Section - Enhanced */
    .stats-section {
      background: rgba(21, 40, 68, 0.6);
      backdrop-filter: blur(20px);
      padding: 2rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      position: relative;
      z-index: 1;
    }
    
    @media (min-width: 768px) {
      .stats-section {
        padding: 3rem 0;
      }
    }
    
    .stat-card {
      background: linear-gradient(135deg, rgba(0, 149, 255, 0.1) 0%, rgba(52, 199, 255, 0.05) 100%);
      border-radius: 18px;
      padding: 1.75rem 1.25rem;
      text-align: center;
      border: 2px solid rgba(0, 149, 255, 0.2);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      margin-bottom: 1.25rem;
      height: 100%;
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(10px);
    }
    
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #0095FF 0%, #00D4FF 100%);
      transform: scaleX(0);
      transition: transform 0.4s ease;
    }
    
    @media (min-width: 768px) {
      .stat-card {
        border-radius: 20px;
        padding: 2rem 1.5rem;
        margin-bottom: 0;
      }
    }
    
    @media (min-width: 768px) {
      .stat-card:hover {
        transform: translateY(-8px) scale(1.02);
        border-color: #0095FF;
        box-shadow: 0 15px 40px rgba(0, 149, 255, 0.3);
        background: linear-gradient(135deg, rgba(0, 149, 255, 0.15) 0%, rgba(52, 199, 255, 0.1) 100%);
      }
      
      .stat-card:hover::before {
        transform: scaleX(1);
      }
    }
    
    .stat-icon {
      width: 65px;
      height: 65px;
      background: linear-gradient(135deg, #0095FF 0%, #00D4FF 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      font-size: 1.8rem;
      color: white;
      box-shadow: 0 8px 25px rgba(0, 149, 255, 0.4);
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
    }
    
    .stat-icon::after {
      content: '';
      position: absolute;
      inset: -5px;
      border-radius: 50%;
      border: 2px solid rgba(0, 149, 255, 0.3);
      animation: pulse 2s ease-in-out infinite;
    }
    
    @keyframes pulse {
      0%, 100% {
        transform: scale(1);
        opacity: 0.5;
      }
      50% {
        transform: scale(1.1);
        opacity: 0;
      }
    }
    
    @media (min-width: 768px) {
      .stat-icon {
        width: 75px;
        height: 75px;
        font-size: 2rem;
        margin-bottom: 1.25rem;
      }
      
      .stat-card:hover .stat-icon {
        transform: scale(1.15) rotate(10deg);
        box-shadow: 0 12px 35px rgba(0, 149, 255, 0.5);
      }
    }
    
    .stat-number {
      font-family: 'Bebas Neue', cursive;
      font-size: 2.2rem;
      background: linear-gradient(135deg, #00D4FF 0%, #0095FF 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 0;
      line-height: 1;
      font-weight: 700;
      letter-spacing: 1px;
    }
    
    @media (min-width: 768px) {
      .stat-number {
        font-size: 2.8rem;
      }
    }
    
    @media (min-width: 992px) {
      .stat-number {
        font-size: 3rem;
      }
    }
    
    .stat-label {
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 0.5rem;
      font-weight: 600;
    }
    
    @media (min-width: 768px) {
      .stat-label {
        font-size: 0.95rem;
        letter-spacing: 1.5px;
      }
    }
    
    /* Content Section */
    .content-section {
      padding: 3rem 0;
      position: relative;
      z-index: 1;
    }
    
    @media (min-width: 768px) {
      .content-section {
        padding: 4rem 0;
      }
    }
    
    .section-header {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 2px solid rgba(0, 149, 255, 0.2);
      position: relative;
    }
    
    .section-header::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100px;
      height: 2px;
      background: linear-gradient(90deg, #0095FF 0%, #00D4FF 100%);
    }
    
    @media (min-width: 768px) {
      .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3rem;
      }
    }
    
    .section-title {
      font-family: 'Bebas Neue', cursive;
      font-size: 1.8rem;
      color: white;
      letter-spacing: 1.5px;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      line-height: 1.1;
      font-weight: 700;
    }
    
    @media (min-width: 768px) {
      .section-title {
        font-size: 2.2rem;
        gap: 1rem;
        letter-spacing: 2px;
      }
    }
    
    @media (min-width: 992px) {
      .section-title {
        font-size: 2.5rem;
      }
    }
    
    .section-title i {
      color: #00D4FF;
      font-size: 1.8rem;
      filter: drop-shadow(0 2px 8px rgba(0, 212, 255, 0.5));
    }
    
    @media (min-width: 768px) {
      .section-title i {
        font-size: 2.2rem;
      }
    }
    
    /* Match Cards - Enhanced */
    .match-card {
      background: linear-gradient(135deg, rgba(21, 40, 68, 0.8) 0%, rgba(11, 31, 63, 0.9) 100%);
      backdrop-filter: blur(20px);
      border-radius: 18px;
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      border: 2px solid rgba(0, 149, 255, 0.15);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      animation: fadeInUp 0.5s ease-out;
      touch-action: manipulation;
      position: relative;
      overflow: hidden;
    }
    
    .match-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 5px;
      height: 100%;
      background: linear-gradient(180deg, #0095FF 0%, #00D4FF 100%);
      transform: scaleY(0);
      transition: transform 0.4s ease;
    }
    
    @media (min-width: 768px) {
      .match-card {
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
      }
    }
    
    .match-card:active {
      transform: scale(0.99);
    }
    
    @media (min-width: 768px) {
      .match-card:hover {
        transform: translateX(8px);
        border-color: #0095FF;
        box-shadow: 0 10px 40px rgba(0, 149, 255, 0.3);
      }
      
      .match-card:hover::before {
        transform: scaleY(1);
      }
    }
    
    .match-header {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    
    @media (min-width: 576px) {
      .match-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
      }
    }
    
    .match-title {
      font-weight: 700;
      font-size: 1.1rem;
      color: white;
      margin: 0;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    @media (min-width: 768px) {
      .match-title {
        font-size: 1.25rem;
      }
    }
    
    .match-status {
      background: linear-gradient(135deg, #0095FF 0%, #00D4FF 100%);
      color: white;
      padding: 0.5rem 1.25rem;
      border-radius: 25px;
      font-size: 0.8rem;
      font-weight: 700;
      white-space: nowrap;
      width: fit-content;
      box-shadow: 0 4px 12px rgba(0, 149, 255, 0.3);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    
    .match-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.9rem;
      background: rgba(0, 149, 255, 0.05);
      padding: 1.25rem;
      border-radius: 12px;
      border: 1px solid rgba(0, 149, 255, 0.1);
    }
    
    @media (min-width: 576px) {
      .match-info {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding: 1.5rem;
      }
    }
    
    .match-info-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      flex: 1;
      min-width: 220px;
    }
    
    @media (min-width: 768px) {
      .match-info-item {
        align-items: center;
        font-size: 0.95rem;
      }
    }
    
    .match-info-item i {
      color: #00D4FF;
      font-size: 1.15rem;
      margin-top: 0.15rem;
      flex-shrink: 0;
      filter: drop-shadow(0 2px 4px rgba(0, 212, 255, 0.3));
    }
    
    @media (min-width: 768px) {
      .match-info-item i {
        margin-top: 0;
        font-size: 1.25rem;
      }
    }
    
    /* Match Actions - Enhanced */
    .match-actions {
      margin-top: 1.5rem;
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    
    .match-actions .btn {
      padding: 0.75rem 1.5rem;
      border-radius: 12px;
      font-size: 0.95rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 48px;
      flex: 1;
      justify-content: center;
      transition: all 0.3s ease;
      border: 2px solid transparent;
      position: relative;
      overflow: hidden;
    }
    
    .match-actions .btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transform: translate(-50%, -50%);
      transition: width 0.4s, height 0.4s;
    }
    
    .match-actions .btn:active::before {
      width: 250px;
      height: 250px;
    }
    
    .match-actions .btn-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }
    
    @media (min-width: 768px) {
      .match-actions .btn-success:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
      }
    }
    
    @media (min-width: 576px) {
      .match-actions .btn {
        flex: 0 1 auto;
        min-height: 50px;
        padding: 0.85rem 1.75rem;
      }
    }
    
    .match-actions .btn i {
      font-size: 1.15rem;
    }
    
    /* Empty State - Enhanced */
    .empty-state {
      background: linear-gradient(135deg, rgba(21, 40, 68, 0.6) 0%, rgba(11, 31, 63, 0.8) 100%);
      backdrop-filter: blur(20px);
      border-radius: 20px;
      padding: 3rem 2rem;
      text-align: center;
      border: 2px dashed rgba(0, 149, 255, 0.3);
      animation: fadeInUp 0.6s ease-out;
    }
    
    @media (min-width: 768px) {
      .empty-state {
        border-radius: 24px;
        padding: 4rem 3rem;
      }
    }
    
    @media (min-width: 992px) {
      .empty-state {
        border-radius: 28px;
        padding: 5rem 3rem;
      }
    }
    
    .empty-icon {
      width: 100px;
      height: 100px;
      background: linear-gradient(135deg, rgba(0, 149, 255, 0.15) 0%, rgba(52, 199, 255, 0.1) 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 2rem;
      font-size: 2.5rem;
      color: #00D4FF;
      border: 3px solid rgba(0, 149, 255, 0.2);
      animation: float 3s ease-in-out infinite;
      position: relative;
    }
    
    .empty-icon::after {
      content: '';
      position: absolute;
      inset: -8px;
      border-radius: 50%;
      border: 2px solid rgba(0, 212, 255, 0.2);
      animation: pulse 2.5s ease-in-out infinite;
    }
    
    @media (min-width: 768px) {
      .empty-icon {
        width: 120px;
        height: 120px;
        font-size: 3rem;
      }
    }
    
    @media (min-width: 992px) {
      .empty-icon {
        width: 140px;
        height: 140px;
        font-size: 3.5rem;
      }
    }
    
    .empty-title {
      font-family: 'Bebas Neue', cursive;
      font-size: 1.8rem;
      color: white;
      margin-bottom: 1rem;
      letter-spacing: 1.5px;
      line-height: 1.1;
      font-weight: 700;
    }
    
    @media (min-width: 768px) {
      .empty-title {
        font-size: 2.2rem;
        margin-bottom: 1.25rem;
        letter-spacing: 2px;
      }
    }
    
    @media (min-width: 992px) {
      .empty-title {
        font-size: 2.5rem;
      }
    }
    
    .empty-text {
      color: rgba(255, 255, 255, 0.7);
      font-size: 1rem;
      margin: 0 auto 2rem;
      line-height: 1.6;
      max-width: 500px;
    }
    
    @media (min-width: 768px) {
      .empty-text {
        font-size: 1.1rem;
        max-width: 600px;
        margin-bottom: 2.5rem;
