  //- Mobile Optimized JavaScript
  script.
    (function() {
      'use strict';
      
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

      
      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            const offset = window.innerWidth < 768 ? 70 : 90;
            const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - offset;
            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
          }
        });
      });
      
      const tickets = !{JSON.stringify(tickets)};
      const modal = document.getElementById('ticketModal');
      const userTicketMap = !{JSON.stringify(userTicketMap || {})};
      const isLoggedIn = !{JSON.stringify(isLoggedIn)};
      
      modal.addEventListener('show.bs.modal', e => {
        const btn = e.relatedTarget;
        const matchId = btn.getAttribute('data-match-id');
        const list = tickets.filter(t => t.match_id == matchId);
        const body = document.getElementById('ticketModalBody');
        
        if (!list.length) {
          body.innerHTML = '<div class="text-center py-4"><i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 3rem;"></i><p class="mt-3 text-muted">Tiket tidak tersedia</p></div>';
          return;
        }
        
        body.innerHTML = list.map(t => {
          const bought = userTicketMap[t.id] || 0;
          const max = t.max_per_user || 1;
          const remaining = Math.max(0, max - bought);
          
          if (!isLoggedIn) {
            return `
              <div class="border rounded p-4 mb-3 shadow-sm">
                <h6 class="mb-3"><i class="bi bi-ticket-detailed me-2 text-primary"></i>${t.name}</h6>
                <p class="mb-2"><i class="bi bi-currency-exchange"></i><strong>Rp ${Number(t.price).toLocaleString()}</strong></p>
                <p class="mb-2"><i class="bi bi-ticket"></i>Sisa: <strong>${t.available} tiket</strong></p>
                <p class="mb-4"><i class="bi bi-person-check"></i>Batas: <strong>${max} tiket/akun</strong></p>
                <a href="/login?next=${encodeURIComponent(location.pathname)}" class="btn btn-warning w-100">
                  <i class="bi bi-box-arrow-in-right me-2"></i>Login untuk beli tiket
                </a>
              </div>
            `;
          }
          
          return `
            <div class="border rounded p-4 mb-3 shadow-sm">
              <h6 class="mb-3"><i class="bi bi-ticket-detailed me-2 text-primary"></i>${t.name}</h6>
              <p class="mb-2"><i class="bi bi-currency-exchange"></i><strong>Rp ${Number(t.price).toLocaleString()}</strong></p>
              <p class="mb-2"><i class="bi bi-ticket"></i>Sisa kuota: <strong>${t.available}</strong></p>
              <p class="mb-2"><i class="bi bi-person-check"></i>Batas: <strong>${max} tiket/akun</strong></p>
              <p class="mb-4 text-success"><i class="bi bi-check-circle-fill"></i>Sudah dibeli: <strong>${bought}</strong></p>
              <form method="POST" action="/purchase/buy" class="ticket-purchase-form">
                <input type="hidden" name="ticket_type_id" value="${t.id}">
                <div class="mb-3">
                  <label class="form-label fw-bold">Jumlah tiket:</label>
                  <input type="number" name="quantity" class="form-control form-control-lg" min="1" max="${remaining}" value="1" ${remaining <= 0 ? 'disabled' : ''}>
                </div>
                <button type="submit" class="btn btn-primary w-100" ${remaining <= 0 ? 'disabled' : ''}>
                  <i class="bi bi-cart-check-fill me-2"></i>${remaining <= 0 ? 'Limit pembelian tercapai' : 'Beli Tiket Sekarang'}
                </button>
              </form>
            </div>
          `;
        }).join('');
      });
      
      // Touch feedback
      if (isTouchDevice) {
        ['.stat-card', '.match-card', '.btn-hero', '.btn-success'].forEach(selector => {
          document.querySelectorAll(selector).forEach(el => {
            el.addEventListener('touchstart', () => el.classList.add('touch-active'), { passive: true });
            el.addEventListener('touchend', () => setTimeout(() => el.classList.remove('touch-active'), 150), { passive: true });
          });
        });
      }
      
      // Intersection Observer
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.style.opacity = '1';
              entry.target.style.transform = 'translateY(0)';
            }
          });
        }, { threshold: 0.05, rootMargin: '30px' });
        
        document.querySelectorAll('.match-card, .stat-card').forEach(card => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(15px)';
          card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
          observer.observe(card);
        });
      }
    })();
