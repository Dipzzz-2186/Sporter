    //- Content Section
    .content-section#jadwal
      .container
        .section-header
          .section-title
            i.bi.bi-calendar-range-fill
            span Jadwal Pertandingan
          
        - const ticketMap = {};
        - tickets.forEach(t => {
        -   if (!ticketMap[t.match_id]) ticketMap[t.match_id] = [];
        -   ticketMap[t.match_id].push(t);
        - });

        if matches.length
          each m in matches
            .match-card
              .match-header
                h3.match-title= m.title
                .match-status
                  i.bi.bi-record-circle-fill
                  span Status
              
              .match-info
                .match-info-item
                  i.bi.bi-clock-fill
                  span= new Date(m.start_time).toLocaleString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })
                
                if m.venue_name
                  .match-info-item
                    i.bi.bi-geo-alt-fill
                    span= m.venue_name
                else
                  .match-info-item
                    i.bi.bi-geo-alt-fill
                    span Venue belum ditentukan

                - const matchTickets = ticketMap[m.id] || []
                - const isFuture = new Date(m.start_time) > new Date()
                - const hasAvailable = matchTickets.some(t => t.available > 0)

                .match-actions
                  if !isFuture
                    span.badge.bg-secondary Jadwal lewat
                  else if !hasAvailable
                    span.badge.bg-danger Tiket habis
                  else
                    button.btn.btn-success(
                      type="button"
                      data-bs-toggle="modal"
                      data-bs-target="#ticketModal"
                      data-match-id=m.id
                      aria-label="Beli tiket untuk pertandingan ini"
                    )
                      i.bi.bi-ticket-perforated-fill
                      span Beli Tiket

        else
          .empty-state
            .empty-icon
              i.bi.bi-calendar-x-fill
            h2.empty-title Belum Ada Jadwal
            p.empty-text Di halaman ini nanti akan tampil daftar event & jadwal khusus untuk cabang olahraga #{sport.name}.
            if currentUser && currentUser.role == 'subadmin'
              a.btn.btn-hero-primary.mt-3(href="/subadmin/matches/create")
                i.bi.bi-plus-circle-fill
                span Tambah Pertandingan

