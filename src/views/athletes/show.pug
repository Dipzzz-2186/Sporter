extends ../layout/main

block content
  - const photo = athlete.photo_url || null;
  - const eff = Number(effectiveness || 0).toFixed(1);
  - const isSubadmin = currentUser && (currentUser.role === 'subadmin' || currentUser.role === 'admin');
  - const mp = (stats && stats.match_played) ? stats.match_played : 0;
  - const mw = (stats && stats.match_won) ? stats.match_won : 0;
  - const ml = (stats && stats.match_lost) ? stats.match_lost : 0;
  - const winRate = stats && stats.match_played > 0 ? ((stats.match_won / stats.match_played) * 100).toFixed(1) : 0;
  
  style.
    /* Professional Athlete Profile */
    .athlete-profile-page {
      background: #f5f7fa;
      min-height: 100vh;
    }
    
    /* Hero Section */
    .athlete-hero {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      position: relative;
      overflow: hidden;
      padding: 0;
    }
    
    .athlete-hero::before {
      content: '';
      position: absolute;
      top: -30%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(0, 122, 255, 0.08) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    
    .hero-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 0;
      position: relative;
      z-index: 2;
    }
    
    /* Back Button */
    .btn-back-hero {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      text-decoration: none;
      margin-bottom: 2rem;
    }
    
    .btn-back-hero:hover {
      background: rgba(255, 255, 255, 0.2);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateX(-3px);
      color: white;
    }
    
    /* Hero Grid */
    .hero-grid {
      display: grid;
      grid-template-columns: 200px 1fr 100px;
      gap: 2rem;
      align-items: start;
      padding-bottom: 2rem;
    }
    
    /* Avatar */
    .athlete-avatar-container {
      position: relative;
    }
    
    .athlete-avatar {
      width: 200px;
      height: 200px;
      border-radius: 16px;
      object-fit: cover;
      border: 4px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      background: rgba(255, 255, 255, 0.05);
    }
    
    .avatar-placeholder {
      width: 200px;
      height: 200px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.05);
      border: 4px solid rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    
    .avatar-placeholder i {
      font-size: 5rem;
      color: rgba(255, 255, 255, 0.3);
    }
    
    /* Hero Content */
    .hero-content {
      padding-top: 1rem;
    }
    
    .athlete-name {
      font-size: 2.5rem;
      font-weight: 800;
      color: white;
      margin-bottom: 1rem;
      letter-spacing: -0.8px;
      line-height: 1.2;
    }
    
    /* Meta Info */
    .athlete-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    
    .meta-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      color: white;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }
    
    .meta-badge:hover {
      background: rgba(255, 255, 255, 0.18);
      transform: translateY(-2px);
    }
    
    .meta-badge i {
      font-size: 1rem;
      opacity: 0.9;
    }
    
    .meta-badge a {
      color: white;
      text-decoration: underline;
    }
    
    /* Info Grid */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-top: 1.5rem;
    }
    
    .info-card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      transition: all 0.2s ease;
    }
    
    .info-card:hover {
      background: rgba(255, 255, 255, 0.12);
      transform: translateY(-2px);
    }
    
    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: white;
    }
    
    .info-row:not(:last-child) {
      margin-bottom: 0.75rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .info-label {
      font-size: 0.8125rem;
      opacity: 0.8;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .info-value {
      font-weight: 700;
      font-size: 0.9375rem;
      text-align: right;
    }
    
    /* Rank Badge */
    .rank-badge {
      width: 100px;
      height: 100px;
      background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(255, 215, 0, 0.3);
      position: relative;
    }
    
    .rank-label {
      font-size: 0.625rem;
      font-weight: 700;
      color: #1a1a2e;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 0.25rem;
    }
    
    .rank-number {
      font-size: 2.5rem;
      font-weight: 900;
      color: #1a1a2e;
      line-height: 1;
    }
    
    /* Edit Button */
    .btn-edit-profile {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: white;
      padding: 0.5rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
      margin-top: 1rem;
    }
    
    .btn-edit-profile:hover {
      background: rgba(255, 255, 255, 0.25);
      border-color: rgba(255, 255, 255, 0.35);
      color: white;
      transform: translateY(-2px);
    }
    
    /* Stats Section */
    .stats-section {
      background: white;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
      position: relative;
      z-index: 3;
    }
    
    .stats-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
    }
    
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    
    .stat-card {
      background: white;
      border: 1px solid #e8ecef;
      border-radius: 12px;
      padding: 1.75rem 1.25rem;
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #007aff 0%, #0051d5 100%);
    }
    
    .stat-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      border-color: rgba(0, 122, 255, 0.3);
    }
    
    .stat-icon {
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, #007aff 0%, #0051d5 100%);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      color: white;
      font-size: 1.5rem;
    }
    
    .stat-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.5rem;
    }
    
    .stat-value {
      font-size: 2rem;
      font-weight: 900;
      color: #1a1a2e;
      line-height: 1;
      margin-bottom: 0.25rem;
    }
    
    .stat-subtext {
      font-size: 0.75rem;
      color: #9ca3af;
      margin-top: 0.5rem;
    }
    
    /* Content Section */
    .content-section {
      background: #f5f7fa;
      padding: 2.5rem 0 4rem;
    }
    
    .content-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    
    .content-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    
    .content-card {
      background: white;
      border: 1px solid #e8ecef;
      border-radius: 12px;
      padding: 1.75rem;
      transition: all 0.3s ease;
    }
    
    .content-card:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
      transform: translateY(-2px);
    }
    
    .card-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #f3f4f6;
    }
    
    .card-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #007aff 0%, #0051d5 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.25rem;
    }
    
    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1a1a2e;
      margin: 0;
      letter-spacing: -0.3px;
    }
    
    /* Bio */
    .bio-text {
      font-size: 0.9375rem;
      line-height: 1.7;
      color: #374151;
      margin-bottom: 0;
    }
    
    /* Info Badges */
    .info-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    
    .info-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 600;
      color: #374151;
    }
    
    .info-badge i {
      color: #007aff;
    }
    
    /* Tables */
    .table-responsive {
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #e8ecef;
    }
    
    .custom-table {
      width: 100%;
      margin: 0;
      border-collapse: collapse;
    }
    
    .custom-table thead th {
      background: #f8f9fa;
      color: #6b7280;
      border: none;
      padding: 0.875rem 1rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 700;
      text-align: left;
      border-bottom: 2px solid #e8ecef;
    }
    
    .custom-table tbody td {
      padding: 1rem;
      border-bottom: 1px solid #f3f4f6;
      color: #374151;
      font-size: 0.875rem;
    }
    
    .custom-table tbody tr:hover {
      background: #f8f9fa;
    }
    
    .custom-table tbody tr:last-child td {
      border-bottom: none;
    }
    
    /* Full Width Card */
    .card-full {
      grid-column: span 2;
    }
    
    /* Modal */
    .modal-content {
      border-radius: 16px;
      border: none;
      overflow: hidden;
    }
    
    .modal-header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: white;
      border: none;
      padding: 1.5rem;
    }
    
    .modal-body {
      padding: 1.75rem;
      max-height: 70vh;
      overflow-y: auto;
    }
    
    .modal-footer {
      padding: 1.25rem 1.75rem;
      background: #f8f9fa;
      border-top: 1px solid #e8ecef;
    }
    
    .form-label {
      font-weight: 600;
      font-size: 0.875rem;
      color: #374151;
      margin-bottom: 0.5rem;
    }
    
    .form-control {
      border-radius: 8px;
      border: 1px solid #d1d5db;
      padding: 0.625rem 0.875rem;
      font-size: 0.9375rem;
      transition: all 0.2s ease;
    }
    
    .form-control:focus {
      border-color: #007aff;
      box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.1);
    }
    
    /* Badges */
    .badge {
      padding: 0.375rem 0.75rem;
      font-weight: 600;
      font-size: 0.75rem;
      border-radius: 6px;
    }
    
    /* Responsive */
    @media (max-width: 991px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        text-align: center;
      }
      
      .athlete-avatar-container,
      .rank-badge {
        margin: 0 auto;
      }
      
      .athlete-meta {
        justify-content: center;
      }
      
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .content-grid {
        grid-template-columns: 1fr;
      }
      
      .card-full {
        grid-column: span 1;
      }
    }
    
    @media (max-width: 767px) {
      .athlete-name {
        font-size: 2rem;
      }
      
      .athlete-avatar,
      .avatar-placeholder {
        width: 150px;
        height: 150px;
      }
      
      .rank-badge {
        width: 80px;
        height: 80px;
      }
      
      .rank-number {
        font-size: 2rem;
      }
      
      .info-grid {
        grid-template-columns: 1fr;
      }
      
      .stats-grid {
        grid-template-columns: 1fr;
      }
      
      .stat-value {
        font-size: 1.75rem;
      }
    }
    
    @media (max-width: 575px) {
      .hero-container,
      .stats-container,
      .content-container {
        padding-left: 1rem;
        padding-right: 1rem;
      }
      
      .athlete-name {
        font-size: 1.75rem;
      }
      
      .content-card {
        padding: 1.25rem;
      }
      
      .card-title {
        font-size: 1.125rem;
      }
    }

  .athlete-profile-page
    //- Hero Section
    .athlete-hero
      .hero-container
        //- Back Button
        a.btn-back-hero(href=backUrl)
          i.bi.bi-arrow-left
          | Kembali
        
        //- Hero Grid
        .hero-grid
          //- Avatar
          .athlete-avatar-container
            if photo
              img.athlete-avatar(src=photo, alt=athlete.name)
            else
              .avatar-placeholder
                i.bi.bi-person-circle
          
          //- Hero Content
          .hero-content
            h1.athlete-name= athlete.name
            
            .athlete-meta
              .meta-badge
                i.bi.bi-flag-fill
                span= athlete.country_code || 'N/A'
              
              .meta-badge
                i.bi.bi-trophy-fill
                span #{athlete.points || 0} Points
              
              if athlete.playing_position
                .meta-badge
                  i.bi.bi-diagram-3-fill
                  span= athlete.playing_position
              
              if athlete.paired_with_name
                .meta-badge
                  i.bi.bi-people-fill
                  span Partner: 
                    if athlete.paired_with_slug
                      a(href=`/athletes/${athlete.paired_with_slug}`)= athlete.paired_with_name
                    else
                      | #{athlete.paired_with_name}
            
            .info-grid
              .info-card
                .info-row
                  span.info-label
                    i.bi.bi-calendar3
                    | Born
                  span.info-value= athlete.born_in || '-'
                .info-row
                  span.info-label
                    i.bi.bi-person-badge
                    | Coach
                  span.info-value= athlete.coach || '-'
              
              .info-card
                .info-row
                  span.info-label
                    i.bi.bi-rulers
                    | Height
                  span.info-value= athlete.height_cm ? `${athlete.height_cm} cm` : '-'
                .info-row
                  span.info-label
                    i.bi.bi-star-fill
                    | Best Rank
                  span.info-value= athlete.best_rank || '-'
            
            if isSubadmin
              button.btn.btn-edit-profile(
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#editAthleteModal"
              )
                i.bi.bi-pencil-square
                | Edit Profile
          
          //- Rank Badge
          .rank-badge
            span.rank-label Rank
            .rank-number #{rank || '-'}
    
    //- Stats Section
    .stats-section
      .stats-container
        .stats-grid
          .stat-card
            .stat-icon
              i.bi.bi-controller
            .stat-label Matches
            .stat-value= stats.match_played || 0
          
          .stat-card
            .stat-icon
              i.bi.bi-trophy-fill
            .stat-label Wins
            .stat-value= stats.match_won || 0
            .stat-subtext Win Rate: #{winRate}%
          
          .stat-card
            .stat-icon
              i.bi.bi-x-circle
            .stat-label Losses
            .stat-value= stats.match_lost || 0
          
          .stat-card
            .stat-icon
              i.bi.bi-graph-up-arrow
            .stat-label Effectiveness
            .stat-value #{eff}%
    
    //- Content Section
    .content-section
      .content-container
        .content-grid
          //- Profile Card
          .content-card
            .card-header
              .card-icon
                i.bi.bi-person-lines-fill
              h2.card-title Player Profile
            
            if athlete.bio
              p.bio-text= athlete.bio
            else
              p.bio-text.text-muted.fst-italic No biography available yet.
            
            hr.my-3
            
            .info-badges
              .info-badge
                i.bi.bi-trophy
                span #{athlete.titles || 0} Titles
              .info-badge
                i.bi.bi-award
                span #{athlete.race || 'N/A'}
          
          //- Points Breakdown Card
          .content-card
            .card-header
              .card-icon
                i.bi.bi-bar-chart-fill
              h2.card-title Points Breakdown
            
            if pointsByTournament && pointsByTournament.length
              .table-responsive
                table.custom-table
                  thead
                    tr
                      th Tournament
                      th Category
                      th.text-center Points
                      th.text-center Last Event
                  tbody
                    each r in pointsByTournament
                      tr
                        td
                          strong= r.tournament
                        td
                          span.badge.bg-light.text-dark= r.category || '-'
                        td.text-center
                          span.fw-bold.text-primary= r.total_points
                        td.text-center.small.text-muted
                          = r.last_event ? new Date(r.last_event).toLocaleDateString('id-ID') : '-'
            else
              p.text-muted.mb-0.fst-italic No tournament points data available.
          
          //- Points History Card
          .content-card.card-full
            .card-header
              .card-icon
                i.bi.bi-clock-history
              h2.card-title Points History
            
            if pointsBreakdown && pointsBreakdown.length
              .table-responsive
                table.custom-table
                  thead
                    tr
                      th Date
                      th Tournament
                      th Category
                      th Round
                      th.text-center Points
                  tbody
                    each r in pointsBreakdown
                      tr
                        td.small
                          i.bi.bi-calendar-event.me-2
                          = r.event_date ? new Date(r.event_date).toLocaleDateString('id-ID') : '-'
                        td
                          strong= r.tournament
                        td
                          span.badge.bg-light.text-dark= r.category || '-'
                        td= r.round_name || '-'
                        td.text-center
                          span.badge.bg-primary= r.points
            else
              p.text-muted.mb-0.fst-italic No points history available.

    //- Edit Modal
    if isSubadmin
      .modal.fade#editAthleteModal(tabindex="-1")
        .modal-dialog.modal-lg
          .modal-content
            form(method="POST" action=`/subadmin/athletes/${athlete.id}` enctype="multipart/form-data")
              .modal-header
                h5.modal-title
                  i.bi.bi-pencil-square.me-2
                  | Edit Athlete Profile
                button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal")
              
              .modal-body
                .row.g-3
                  .col-md-6
                    label.form-label Name *
                    input.form-control(type="text" name="name" required value=athlete.name)
                  .col-md-6
                    label.form-label Country Code
                    input.form-control(type="text" name="country_code" value=(athlete.country_code || ''))
                  
                  .col-md-6
                    label.form-label Position
                    input.form-control(type="text" name="playing_position" value=(athlete.playing_position || ''))
                  .col-md-6
                    label.form-label Coach
                    input.form-control(type="text" name="coach" value=(athlete.coach || ''))
                  
                  .col-md-6
                    label.form-label Born in
                    input.form-control(type="text" name="born_in" value=(athlete.born_in || ''))
                  .col-md-6
                    label.form-label Height (cm)
                    input.form-control(type="number" name="height_cm" value=(athlete.height_cm || ''))
                  
                  .col-md-12
                    label.form-label Biography
                    textarea.form-control(name="bio" rows="4")= athlete.bio || ''
                  
                  .col-md-6
                    label.form-label Titles
                    input.form-control(type="number" name="titles" value=(athlete.titles || 0))
                  .col-md-6
                    label.form-label Race
                    input.form-control(type="text" name="race" value=(athlete.race || ''))
                  
                  .col-md-12
                    label.form-label Athlete Photo
                    input.form-control(type="file" name="photo" accept="image/*")
                    if athlete.photo_url
                      small.text-muted.d-block.mt-2 Current: #{athlete.photo_url}
              
              .modal-footer
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                button.btn.btn-primary(type="submit")
                  i.bi.bi-check-circle.me-2
                  | Save Changes